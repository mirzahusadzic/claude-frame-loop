{
  "modules": ["./band.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{"type": "command", "timeout": 30, "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\""}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "timeout": 30, "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\""}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "timeout": 600, "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\""}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "timeout": 600, "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\""}]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "timeout": 30, "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\""}]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{"type": "command", "timeout": 30, "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\""}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "timeout": 600, "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\""}]
      }
    ]
  }
}
